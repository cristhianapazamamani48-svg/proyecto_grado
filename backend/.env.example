# Copia este archivo a `.env` y completa los valores.
# El backend NO arranca sin un JWT_SECRET propio (>= 32 caracteres).

# URL de conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:@127.0.0.1:5432/uub_evaluaciones?schema=public"

# Secreto para firmar tokens JWT. OBLIGATORIO. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Puerto del API
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Google OAuth. Crea un cliente web en Google Cloud y registra sus orígenes autorizados.
GOOGLE_CLIENT_ID=

# Proveedor de IA: mock | openai | gemini | claude
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-v1
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3

# Cuenta inicial de superusuario (se crea solo si no existe ningún SUPER_ADMIN).
# SUPERADMIN_PASSWORD es obligatoria en producción y no admite el valor
# por defecto público "SuperAdminSecret2026!".
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Pasarelas de Pago ──────────────────────────────────────────────────────────
# Proveedor por defecto: MOCK_SANDBOX | LIVEES | MERCADOPAGO | PAYPAL
PAYMENT_PROVIDER=LIVEES

# Livees Checkout (Pasarela oficial para Bolivia - QR Simple, Yape, Yolo, Altoke, Tarjetas)
LIVEES_MERCHANT_TOKEN=
LIVEES_RESOURCE_KEY=
LIVEES_WEBHOOK_SECRET=
LIVEES_API_URL=https://api.livees.net/v1

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

