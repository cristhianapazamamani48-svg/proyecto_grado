# Copia este archivo a `.env` y completa los valores.
# El backend NO arranca sin un JWT_SECRET propio (>= 32 caracteres).

# URL de conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:@127.0.0.1:5432/uub_evaluaciones?schema=public"

# Secreto para firmar tokens JWT. OBLIGATORIO. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Puerto del API
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# URL publica del frontend, usada para enlaces enviados por correo.
FRONTEND_URL=http://localhost:3002

# Correo: console (solo desarrollo/pruebas) | resend. En produccion se exige resend.
MAIL_PROVIDER=console
# Obligatorios cuando MAIL_PROVIDER=resend. No subir valores reales.
MAIL_API_KEY=
MAIL_FROM=
# Tiempo máximo de espera del proveedor de correo, en milisegundos.
MAIL_TIMEOUT_MS=10000

# Google OAuth. Crea un cliente web en Google Cloud y registra sus orígenes autorizados.
GOOGLE_CLIENT_ID=

# Proveedor de IA: mock | openai | gemini | claude
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mock-v1
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.3

# Cuenta inicial de superusuario (se crea solo si no existe ningún SUPER_ADMIN).
# SUPERADMIN_PASSWORD es obligatoria en producción y no admite el valor
# por defecto público "SuperAdminSecret2026!".
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Pasarelas de Pago ──────────────────────────────────────────────────────────
# Proveedor por defecto: MOCK_SANDBOX | LIVEES | MERCADOPAGO | PAYPAL | LIBELULA
PAYMENT_PROVIDER=LIVEES

# Livees Checkout (Pasarela oficial para Bolivia - QR Simple, Yape, Yolo, Altoke, Tarjetas)
LIVEES_MERCHANT_TOKEN=
LIVEES_RESOURCE_KEY=
LIVEES_WEBHOOK_SECRET=
LIVEES_API_URL=https://api.livees.net/v1
# IMPORTANTE: la API de Livees incluida en el código aún no está verificada con el proveedor.

# Libélula Bolivia. LIBELULA_APPKEY es obligatorio cuando PAYMENT_PROVIDER=LIBELULA
# o cuando se inicia un checkout mediante este proveedor.
LIBELULA_APPKEY=
LIBELULA_API_URL=https://api.libelula.bo
# URL pública del backend que recibe el callback GET de Libélula.
LIBELULA_CALLBACK_URL=http://localhost:3001
LIBELULA_DEUDA_DIAS=3
# La facturación queda apagada hasta que la organización almacene NIT/CI y razón social.
LIBELULA_EMITE_FACTURA=false

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Periodos prepagados. Los multiplicadores 1.0 no aplican descuento.
# Solo LIVEES y MOCK_SANDBOX permiten periodos de 3 o 12 meses.
PAGO_MULTIPLICADOR_3_MESES=1.0
PAGO_MULTIPLICADOR_12_MESES=1.0
# Un webhook RECIBIDO se puede reclamar tras este plazo (milisegundos).
WEBHOOK_EVENTO_ABANDONADO_MS=300000

